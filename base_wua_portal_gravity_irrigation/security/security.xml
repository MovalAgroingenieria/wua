<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_wua_wateringrequest_group_portal" model="ir.rule">
            <field name="name">Rule for Portal on watering requests</field>
            <field name="model_id" ref="base_wua_gravity_irrigation.model_wua_wateringrequest"/>
            <field name="domain_force">
                ['|', ('partner_id','=',user.partner_id.id),
                      ('partner_id.child_ids','=',user.partner_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_wua_gravconsumption_group_portal" model="ir.rule">
            <field name="name">Rule for Portal on gravity consumptions</field>
            <field name="model_id" ref="base_wua_gravity_irrigation.model_wua_gravconsumption"/>
            <field name="domain_force">
                ['|', '|', ('partner_id','=',user.partner_id.id),
                           ('partner_id.child_ids','=',user.partner_id.id),
                           ('partner_id','=',False)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wua_irrigation_config_settings_view_form_kuvio"
            model="ir.ui.view">
        <field name="name">Parameters (Kuvio)</field>
        <field name="model">wua.irrigation.configuration</field>
        <field name="inherit_id"
               ref="base_wua_remotecontrol_rest.wua_irrigation_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='remote_control']" position="after">
                <group name="remote_control_kuvio"
                       string="Kuvio REST API"
                       attrs="{'invisible': [('enable_remotecontrol', '=', False)]}">
                    <field name="import_from_readings_kuvio"
                           attrs="{'invisible': [('enable_remotecontrol', '=', False)]}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>

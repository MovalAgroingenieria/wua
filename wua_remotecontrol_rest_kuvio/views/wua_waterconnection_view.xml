<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wua_waterconnection_view_form_kuvio" model="ir.ui.view">
        <field name="name">wua.waterconnection form (wua_remotecontrol_rest_kuvio)</field>
        <field name="model">wua.waterconnection</field>
        <field name="inherit_id"
               ref="base_wua_remotecontrol_rest.wua_waterconnection_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='telecontrol_associated']"
                   position="after">
                <field name="kuvio_device_id"
                       attrs="{'invisible': [('telecontrol_associated', '!=', 'kuvio')],
                               'required': [('telecontrol_associated', '=', 'kuvio')]}"/>
            </xpath>
        </field>
    </record>

</odoo>

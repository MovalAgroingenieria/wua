<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.portal.users.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_wua.view_partner_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[1]"
                   position="before">
                <field name="user_count" invisible="1"/>
                <button name="action_view_users"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                        attrs="{'invisible':[('user_count','=',0)]}"
                        groups="base_wua.group_wua_user">
                    <field name="user_count" widget="statinfo"
                           string="Users"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
